{
    "name": "ft-workspace",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "prune:frontend": "node scripts/prune-vite-assets.mjs --keep 5",
        "preview": "vite preview",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "check:dialogs": "node scripts/check-native-dialogs.mjs",
        "check:email-renderers": "node scripts/check-email-render-contracts.mjs",
        "check:document-types": "node scripts/check-document-type-codes.mjs",
        "lint": "npm run check:dialogs && npm run check:email-renderers && npm run check:document-types && tsc --noEmit"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.1.14",
        "@vitejs/plugin-react": "^5.0.4",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "qrcode": "^1.5.4",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "recharts": "^3.9.2",
        "vite": "^6.2.3",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.21",
        "tailwindcss": "^4.1.14",
        "typescript": "~5.8.2"
    }
