[Unit]
Description=Run automated tech discovery and post suggestions
After=network-online.target workspace-django.service
Wants=network-online.target

[Service]
Type=oneshot
User=workspace
Group=www-data
WorkingDirectory=/var/www/ft-workspace/backend
EnvironmentFile=/var/www/ft-workspace/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_DB_PATH=/home/workspace/ft-workspace-data/workspace.sqlite3
ExecStart=/var/www/ft-workspace/.venv/bin/python manage.py auto_suggest_tech_posts --limit 3 --auto-plan
