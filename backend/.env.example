DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Required in production for encrypted AI provider API keys (Fernet URL-safe base64 key).
AI_CONFIG_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,workspace.fermat.vn
# Local: leave blank to use backend/db.sqlite3. Production: set a durable path
# outside the release directory, for example /var/lib/ft-workspace/data/workspace.sqlite3.
DJANGO_DB_PATH=
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://workspace.fermat.vn
ADMIN_EMAILS=admin@ftsocial.com
BOOTSTRAP_ADMIN_EMAIL=admin@ftsocial.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
# Optional JSON list for additional emergency admins (passwords stay server-side):
# BOOTSTRAP_ADMINS_JSON=[{"email":"second-admin@example.com","password":"replace-with-a-strong-password"}]
GOOGLE_SERVICE_ACCOUNT_JSON=
META_PAGE_TOKENS_JSON={}
META_GRAPH_API_VERSION=v25.0
ZALO_OA_TOKENS_JSON={}
CRON_SECRET=replace-with-a-long-random-value
# Shared secret the Sheet's Apps Script trigger sends as the X-Sheet-Webhook-Secret
# header when calling POST /api/work-schedule/sheet-webhook (realtime Sheet -> Web sync).
SHEET_WEBHOOK_SECRET=replace-with-a-long-random-value

# Friday 16:45 report pipeline. The Sheet ID below points at the shared Fermat
# staging workbook and normally does not need changing. The service account
# must be an editor of this Sheet.
WEEKLY_REPORT_SHEET_ID=1yF78pcry1Pls6M-8f373eVLnsSCVX_QOvvfpD5SYYkM
# Reserved for the later AI/Google Docs stage; not used when creating packets.
WEEKLY_REPORT_DOCUMENT_ID=1TxSOV4atjOgNcRbW6h3Z_KFBoO7Rr8R3vbIzaXiOij8
WEEKLY_REPORT_WEBHOOK_SECRET=replace-with-a-different-long-random-value

# Temporary social dashboard token (keep this value only in backend/.env).
CURRENT_FACEBOOK_ACCESS_TOKEN=
CURRENT_FACEBOOK_TOKEN_TTL_DAYS=60
# New Facebook tokens always use the 60-day lifetime; this legacy setting is ignored.
CURRENT_FACEBOOK_PAGE_ID=
CURRENT_FACEBOOK_PAGE_NAME=Facebook
